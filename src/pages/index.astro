---
import Layout from '../layouts/Layout.astro';

const title = 'Bryan Lim, Senior Software Engineer at Crusoe';
const description = 'Bryan Lim is a Senior Software Engineer at Crusoe in San Francisco. I build cloud infrastructure: Managed Kubernetes, Managed Slurm, and the Crusoe Cloud API platform. On the side I run bankrewards.io.';
---

<Layout title={title} description={description}>
  <header class="hero">
    <img src="/avatar.jpg" alt="Bryan Lim" width="112" height="112" />
    <div>
      <h1>Bryan Lim</h1>
      <p class="role">Senior Software Engineer @ Crusoe</p>
      <p class="loc">San Francisco, CA</p>
    </div>
  </header>

  <p class="intro">
    I build cloud infrastructure. At Crusoe I'm a founding engineer of the
    <strong>Managed Orchestration</strong> team. I designed and launched
    <strong>Managed Kubernetes</strong> and <strong>Managed Slurm</strong>, and I lead
    control-plane load testing. Before that I was one of the first engineers on the
    Crusoe Cloud API platform. On the side I run <a href="https://bankrewards.io" rel="noopener">bankrewards.io</a>,
    a bank-bonus comparison platform serving 50K+ monthly visitors.
  </p>

  <section>
    <h2>Experience</h2>

    <div class="job">
      <div class="job-head">
        <h3>Senior Software Engineer <span>at Crusoe</span></h3>
        <time>Jan 2025 – Present</time>
      </div>
      <ul>
        <li>Founding engineer of Managed Orchestration; launched Crusoe Managed Kubernetes (Alpha &amp; Beta) and Managed Slurm (Alpha). I built the Kubernetes Manager service, HashiCorp Vault certificate management, and fleet-wide control-plane patching.</li>
        <li>Tech Lead for control-plane load testing, ensuring platform reliability, scalability, and performance.</li>
        <li>Architected and provisioned internal bare-metal Kubernetes clusters and core infrastructure.</li>
      </ul>
    </div>

    <div class="job">
      <div class="job-head">
        <h3>Software Engineer <span>at Crusoe</span></h3>
        <time>Sep 2022 – Jan 2025</time>
      </div>
      <ul>
        <li>One of the first 12 engineers on Crusoe Cloud; built API Gateway routes, permissions, and quotas in Go.</li>
        <li>Shipped Instance Templates + Bulk VM Creation across the full stack, and launched Block Storage, Networking, and Multi-Project APIs, including a zero-downtime live migration of every API and database.</li>
        <li>Built observability foundations: OpenTelemetry tracing, feature flags, and sensitivity-based logging. Ran launch-readiness tests that caught critical issues pre-launch.</li>
      </ul>
    </div>
  </section>

  <section>
    <h2>Projects</h2>

    <div class="card featured">
      <div class="card-head">
        <h3><a href="https://bankrewards.io" rel="noopener">bankrewards.io</a></h3>
        <span class="tag">Website creator</span>
      </div>
      <p>Bank, credit-card, and brokerage bonus comparison platform, built end to end: SvelteKit site on Cloudflare Workers (D1), a Payload CMS backend, an automated data pipeline for offer intake and processing, with an LLM-agent stage that continuously re-verifies offers against banks' live pages.</p>
      <div class="stats">
        <div class="stat"><b>54K</b><span>monthly visitors (peak)</span></div>
        <div class="stat"><b>208K</b><span>monthly pageviews (peak)</span></div>
        <div class="stat"><b>$7.3K</b><span>referral revenue, one advertiser</span></div>
      </div>
    </div>

    <a class="more-link" href="/projects">All projects, and why I built each →</a>
  </section>

  <section>
    <h2>Earlier</h2>
    <ul class="compact">
      <li><b>Microsoft</b>, Software Engineer Intern (2020, 2021): built analysis tooling for Azure Front Door (10M+ req/sec) and IPv6 VM auto-registration for Azure Private DNS.</li>
      <li><b>Salesforce</b>, Software Engineering Intern (2019): built GitHub sync used across 300+ projects; added Axe accessibility testing to the company-wide pipeline.</li>
      <li><b>Expedia</b>, Software Developer Apprentice (2018): built an employee badging and awards system for recognizing employees with custom awards.</li>
    </ul>
    <p class="fine">Awards: Best Sustainability Project, Caltech Hackathon (2020) · Health Track Winner, UC Berkeley Hackathon (2021) · 1517 Grant Winner (2020) · 2nd Place, Terminal Global Competition, US West Coast (2021)</p>
  </section>

  <section class="edu">
    <h2>Education</h2>
    <h3>University of Washington <span style="color: var(--muted); font-weight: 400;">, B.S. Computer Science, Minor in Business Administration</span></h3>
    <p>2018 – 2022 · Teaching Assistant: Distributed Systems, Computer Networks, Software Design · Direct admit, Paul G. Allen School</p>
  </section>

  <section>
    <h2>Skills</h2>
    <div class="chips">
      <span>Go</span><span>TypeScript</span><span>Kubernetes</span><span>SvelteKit</span><span>React / Next.js</span><span>Astro</span><span>Cloudflare Workers &amp; D1</span><span>Payload CMS</span><span>Terraform</span><span>HashiCorp Vault</span><span>Playwright</span><span>PostHog</span><span>OpenTelemetry</span><span>AWS</span>
    </div>
  </section>
</Layout>
