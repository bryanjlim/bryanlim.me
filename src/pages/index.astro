---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import Experience from '../components/Experience.astro';
import Background from '../components/Background.astro';
import PersonalPhotos from '../components/PersonalPhotos.astro';
---

<Layout>
  <header class="hero" id="top">
    <div class="hero-copy">
      <h1>Hi, I’m Bryan.</h1>
      <p class="intro">I’m a software engineer in San Francisco. I like turning an idea into something people can use.</p>
      <a class="contact-cta" href="https://linkedin.com/in/bryanjlim">Contact me on LinkedIn ↗</a>
    </div>
    <div class="portrait">
      <img src="/images/bryan-portrait.webp" alt="Bryan Lim" width="656" height="820" fetchpriority="high">
    </div>
  </header>
  <Projects />
  <Experience />
  <Background />
  <PersonalPhotos />
</Layout>
