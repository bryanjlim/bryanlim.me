---
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}
const {
  title = 'Bryan Lim',
  description = 'Bryan Lim, a software engineer in San Francisco. Side projects, work, and a few things I’ve made for myself.',
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Apply a saved choice before the page paints; CSS otherwise follows the system.
      try {
        const theme = localStorage.getItem('bryanlim-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="wrap">
      <nav class="site-nav" aria-label="Main navigation">
        <a class="brand" href="#top"><span class="brand-mark" aria-hidden="true">bl.</span>Bryan Lim</a>
        <div class="nav-links">
          <a href="#projects">Projects</a>
          <a href="#experience">Experience</a>
          <a class="social-nav" href="https://github.com/bryanjlim">GitHub ↗</a>
          <a class="social-nav" href="https://linkedin.com/in/bryanjlim">LinkedIn ↗</a>
          <ThemeToggle />
        </div>
      </nav>
      <main id="main">
        <slot />
      </main>
      <footer>
        <span>© {new Date().getFullYear()} Bryan Lim · San Francisco</span>
        <div class="footer-links">
          <a href="https://github.com/bryanjlim">GitHub ↗</a>
          <a href="https://linkedin.com/in/bryanjlim">LinkedIn ↗</a>
        </div>
      </footer>
    </div>
  </body>
</html>
