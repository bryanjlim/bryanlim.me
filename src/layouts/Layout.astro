---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const github = 'https://github.com/bryanjlim';
const linkedin = 'https://linkedin.com/in/bryanjlim';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://bryanlim.me" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%230ea5e9'/%3E%3Ctext x='50' y='68' font-size='52' font-family='system-ui' font-weight='700' text-anchor='middle' fill='white'%3EB%3C/text%3E%3C/svg%3E" />
    <style>
      :root {
        --bg: #0a0e14;
        --bg-soft: #11161f;
        --border: #1e2633;
        --text: #e8ecf3;
        --muted: #98a2b3;
        --accent: #38bdf8;
        --accent-dim: rgba(56, 189, 248, 0.12);
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html { scroll-behavior: smooth; }
      body {
        background: var(--bg);
        color: var(--text);
        font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      .wrap { max-width: 760px; margin: 0 auto; padding: 0 1.5rem; }

      nav {
        display: flex; justify-content: space-between; align-items: center;
        padding: 1.25rem 0; border-bottom: 1px solid var(--border);
      }
      nav .brand { font-weight: 700; font-size: 1.05rem; color: var(--text); }
      nav .links { display: flex; gap: 1.25rem; font-size: 0.95rem; }

      .hero { display: flex; gap: 1.75rem; align-items: center; padding: 3.5rem 0 2.5rem; }
      .hero img {
        width: 112px; height: 112px; border-radius: 50%; object-fit: cover;
        border: 2px solid var(--border); flex-shrink: 0;
      }
      .hero h1 { font-size: 2.4rem; letter-spacing: -0.02em; line-height: 1.15; }
      .hero .role { color: var(--accent); font-weight: 600; margin-top: 0.35rem; }
      .hero .loc { color: var(--muted); font-size: 0.95rem; }
      .page-head { padding: 3rem 0 1.5rem; }
      .page-head h1 { font-size: 2.2rem; letter-spacing: -0.02em; }
      .page-head p { color: var(--muted); margin-top: 0.5rem; font-size: 1.05rem; max-width: 60ch; }
      .intro { color: var(--muted); font-size: 1.05rem; padding-bottom: 3rem; max-width: 62ch; }
      .intro strong { color: var(--text); font-weight: 600; }

      section { padding: 0 0 3rem; }
      h2 {
        font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.12em;
        color: var(--muted); margin-bottom: 1.25rem;
        padding-bottom: 0.5rem; border-bottom: 1px solid var(--border);
      }
      .job { margin-bottom: 1.75rem; }
      .job-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.25rem; }
      .job-head h3 { font-size: 1.1rem; }
      .job-head h3 span { color: var(--muted); font-weight: 400; }
      .job-head time { color: var(--muted); font-size: 0.9rem; white-space: nowrap; }
      .job ul, .proj ul { margin: 0.6rem 0 0 1.1rem; color: var(--muted); font-size: 0.98rem; }
      .job li, .proj li { margin-bottom: 0.4rem; }
      .job li::marker, .proj li::marker { color: var(--accent); }
      ul.compact { list-style: none; padding: 0; margin: 0; }
      ul.compact li { padding: 0.45rem 0; border-bottom: 1px solid var(--border); color: var(--muted); font-size: 0.98rem; }
      ul.compact li:last-child { border-bottom: 0; }
      ul.compact li b { color: var(--text); font-weight: 600; }
      p.fine { color: var(--muted); font-size: 0.92rem; margin-top: 1.1rem; }

      .card {
        background: var(--bg-soft); border: 1px solid var(--border);
        border-radius: 12px; padding: 1.5rem; margin-bottom: 1.25rem;
      }
      .card.featured { border-color: rgba(56, 189, 248, 0.35); }
      .card-head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.25rem; }
      .card-head h3 { font-size: 1.15rem; }
      .card-head .tag {
        font-size: 0.78rem; color: var(--accent); background: var(--accent-dim);
        padding: 0.15rem 0.6rem; border-radius: 999px; white-space: nowrap;
      }
      .card p { color: var(--muted); font-size: 0.98rem; margin-top: 0.6rem; }
      .card p.why { border-left: 2px solid var(--accent); padding-left: 0.9rem; margin-top: 0.9rem; font-style: italic; }
      .card p.why b { font-style: normal; color: var(--text); }
      .card img.shot {
        width: 100%; border-radius: 10px; margin-bottom: 1.1rem;
        border: 1px solid var(--border); display: block;
      }
      .shots { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; margin-bottom: 1.1rem; }
      .shots .shot-link img { aspect-ratio: 4 / 3; object-fit: cover; height: 100%; margin-bottom: 0; }
      .shot-link { display: block; border-radius: 10px; overflow: hidden; border: 1px solid var(--border); }
      .shot-link img { width: 100%; display: block; cursor: zoom-in; }
      .card > .shot-link { margin-bottom: 1.1rem; }
      .card > .shot-link img { margin-bottom: 0; border: 0; border-radius: 0; max-height: 460px; object-fit: cover; object-position: center top; }
      .lightbox { position: fixed; inset: 0; z-index: 60; display: none; align-items: center; justify-content: center; padding: 2rem; }
      .lightbox:target { display: flex; }
      .lightbox-bg { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.88); }
      .lightbox img { position: relative; max-width: min(92vw, 1100px); max-height: 86vh; border-radius: 10px; }
      .lightbox-close { position: absolute; top: 0.75rem; right: 1.25rem; color: #fff; font-size: 2.2rem; line-height: 1; }
      @media (max-width: 560px) { .shots { grid-template-columns: 1fr; } }
      .stats { display: flex; gap: 2rem; margin-top: 1rem; flex-wrap: wrap; }
      .stat b { display: block; font-size: 1.35rem; color: var(--text); }
      .stat span { font-size: 0.82rem; color: var(--muted); }
      .stack { margin-top: 1rem; font-size: 0.85rem; color: var(--muted); }
      .stack code {
        font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
        background: var(--bg); border: 1px solid var(--border);
        padding: 0.1rem 0.4rem; border-radius: 6px; font-size: 0.8rem;
        margin-right: 0.3rem; white-space: nowrap;
      }

      .calc-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
      .calc-card {
        background: var(--bg-soft); border: 1px solid var(--border);
        border-radius: 12px; padding: 1.25rem;
        display: flex; flex-direction: column; gap: 0.5rem;
      }
      .calc-card h3 { font-size: 1rem; line-height: 1.4; }
      .calc-card p { color: var(--muted); font-size: 0.9rem; flex-grow: 1; }
      .calc-card p.why { font-style: italic; font-size: 0.85rem; }
      .calc-card a.more { font-size: 0.88rem; margin-top: 0.25rem; }

      .more-link {
        display: inline-block; margin-top: 0.5rem; font-weight: 600;
        border: 1px solid var(--border); border-radius: 10px; padding: 0.7rem 1.2rem;
        background: var(--bg-soft);
      }
      .more-link:hover { text-decoration: none; border-color: var(--accent); }

      .edu h3 { font-size: 1.05rem; }
      .edu p { color: var(--muted); font-size: 0.95rem; margin-top: 0.3rem; }

      .chips { display: flex; flex-wrap: wrap; gap: 0.5rem; }
      .chips span {
        font-size: 0.88rem; color: var(--text);
        background: var(--bg-soft); border: 1px solid var(--border);
        padding: 0.3rem 0.8rem; border-radius: 999px;
      }

      footer {
        border-top: 1px solid var(--border); padding: 1.5rem 0 2.5rem;
        color: var(--muted); font-size: 0.88rem;
        display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;
      }

      @media (max-width: 560px) {
        .hero { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
        .hero h1 { font-size: 2rem; }
        .stats { gap: 1.25rem; }
        .calc-grid { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <div class="wrap">
      <nav>
        <a class="brand" href="/" style="color: var(--text);">Bryan Lim</a>
        <div class="links">
          <a href="/projects">Projects</a>
          <a href={github} rel="noopener">GitHub</a>
          <a href={linkedin} rel="noopener">LinkedIn</a>
        </div>
      </nav>

      <slot />

      <footer>
        <span>© 2026 Bryan Lim</span>
        <span>Built with <a href="https://astro.build" rel="noopener">Astro</a>. Zero JavaScript shipped</span>
      </footer>
    </div>
  </body>
</html>
